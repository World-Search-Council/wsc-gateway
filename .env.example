# wsc-gateway environment template for docker-compose
RABBITMQ_URL=amqps://user:password@host.rmq.cloudamqp.com/vhost

# ClickHouse Cloud (Aiven / ClickHouse Cloud TLS)
CLICKHOUSE_HOST=your-instance.aivencloud.com
CLICKHOUSE_PORT=14120
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASS=your_clickhouse_password

# MariaDB / MySQL for Gateway (projects, wsc_verticals, wsc_benchmark_snapshots)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wsc_user
DB_PASS=your_mariadb_password
DB_NAME=wsc_analytics

# Redis Standalone or Redis Cluster (Prio 5.1)
REDIS_URL=redis://redis:6379/0
REDIS_CLUSTER_MODE=false
REDIS_CLUSTER_NODES=
REDIS_PASSWORD=

# Prometheus & Grafana Metrics Optional Bearer Token (Prio 5.2)
METRICS_BEARER_TOKEN=

# SpeedSentinel Headless Playwright Pool
WSC_HEADLESS_SERVERS=http://127.0.0.1:8081
WSC_HEADLESS_API_KEY=your_headless_api_key

# Logging
LOG_LEVEL=INFO

# Traefik reverse proxy (for public HTTPS on 443)
TRAEFIK_DOMAIN=api.worldsearchcouncil.org
ACME_EMAIL=ops@worldsearchcouncil.org
